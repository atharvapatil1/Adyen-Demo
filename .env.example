# Copy this file to .env and fill in your Adyen TEST credentials.
# Customer Area -> Developers -> API credentials
ADYEN_API_KEY=your_api_key
ADYEN_CLIENT_KEY=test_your_client_key
ADYEN_MERCHANT_ACCOUNT=YourMerchantAccountECOM

# Customer Area -> Developers -> Webhooks -> (Standard webhook) -> HMAC key
# Optional for local testing; required before going live.
ADYEN_HMAC_KEY=

# TEST or LIVE
ADYEN_ENVIRONMENT=TEST
# Required for LIVE only: Customer Area -> Developers -> API URLs -> live prefix
ADYEN_LIVE_URL_PREFIX=

PORT=8080
# Public URL of this app, used to build the returnUrl for redirect payment methods.
# Leave empty to derive it from the incoming request (fine for localhost).
BASE_URL=
